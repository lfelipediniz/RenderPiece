# Hollow cuboid cabin shell for the internal environment.
# Local dimensions: width 5.0, depth 4.1, height 3.0.
# The front side (+Z) is open so the camera can see inside.

mtllib cabin_shell.mtl
o CabinShell

v -2.500000 0.000000 -2.050000
v 2.500000 0.000000 -2.050000
v 2.500000 0.000000 2.050000
v -2.500000 0.000000 2.050000
v -2.500000 3.000000 -2.050000
v 2.500000 3.000000 -2.050000
v 2.500000 3.000000 2.050000
v -2.500000 3.000000 2.050000

vt 0.000000 0.000000
vt 3.000000 0.000000
vt 3.000000 2.500000
vt 0.000000 2.500000
vt 0.000000 0.000000
vt 3.000000 0.000000
vt 3.000000 1.800000
vt 0.000000 1.800000
vt 0.000000 0.000000
vt 2.500000 0.000000
vt 2.500000 1.800000
vt 0.000000 1.800000

vn 0.000000 1.000000 0.000000
vn 0.000000 -1.000000 0.000000
vn 0.000000 0.000000 1.000000
vn 1.000000 0.000000 0.000000
vn -1.000000 0.000000 0.000000

usemtl cabin_wood

# Floor
f 1/1/1 2/2/1 3/3/1 4/4/1

# Ceiling, normal points inward/down
f 8/4/2 7/3/2 6/2/2 5/1/2

# Back wall, normal points inward/front
f 1/5/3 5/8/3 6/7/3 2/6/3

# Left wall, normal points inward/right
f 1/9/4 4/10/4 8/11/4 5/12/4

# Right wall, normal points inward/left
f 3/10/5 2/9/5 6/12/5 7/11/5
